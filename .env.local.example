# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채워 넣으세요.
# Supabase 대시보드 → Project Settings → API Keys 에서 확인할 수 있습니다.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# service_role / secret 키는 RLS를 우회하므로 NEXT_PUBLIC_ 을 붙이지 말고,
# 꼭 필요해질 때만 서버 전용으로 추가합니다. (지금 단계에서는 필요 없음)

# ---- 5단계: AI 상담 (서버 전용 — 절대 NEXT_PUBLIC_ 을 붙이지 않는다) ----
# Google AI Studio(aistudio.google.com) → Get API key
GEMINI_API_KEY=
# 비워 두면 gemini-flash-latest 를 쓴다
GEMINI_MODEL=
# Supabase 대시보드 → Project Settings → API Keys → Secret keys (sb_secret_...)
# AI 답변을 DB 에 저장할 때만 서버에서 쓴다. RLS 를 우회하므로 절대 공유·커밋하지 않는다.
SUPABASE_SECRET_KEY=
